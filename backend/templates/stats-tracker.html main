            ${running ? html`<button class="ec-btn" type="button" onClick=${function () { setRunning(false); }}>Pause</button>` : html`<button class="ec-btn ec-btn-success" type="button" onClick=${startTracking}>${seconds || period === 2 ? "Resume" : "Start clock"}</button>`}
            <button class="ec-btn" type="button" onClick=${function () { setRunning(false); setSeconds(0); }}>Reset clock</button>
            <button class="ec-btn ec-btn-danger" type="button" onClick=${handlePeriodEnd}>${period === 1 ? "End 1st half" : "End match"}</button>
          </div>
        </div>
        ${assignment.matchDate || assignment.matchTime || assignment.venue || assignment.competition ? html`<div class="ec-muted">Match: ${formatDate(assignment.matchDate || assignment.match_date)} · ${formatTime(assignment.matchTime || assignment.match_time)} · ${assignment.competition || "Competition not supplied"} · ${assignment.venueStadium || assignment.venue || "Venue not supplied"}</div>` : null}
        <div class="ec-tracker">
          <div class="ec-team-header"><div class="ec-team-name home">${homeTeam || "Home club"}</div><span class="ec-muted">${totalEvents} event${totalEvents === 1 ? "" : "s"}</span><div class="ec-team-name away">${awayTeam || "Away club"}</div></div>
          <div class="ec-possession">
            <button class=${"ec-pos-btn home" + (possession.currentTeam === "home" ? " active" : "")} type="button" onClick=${function () { manualPossession("home"); }}><span class="ec-pos-value">${possession.home}%</span><span class="ec-pos-label">Home possession</span></button>
            <div class="ec-pos-title">Possession</div>
            <button class=${"ec-pos-btn away" + (possession.currentTeam === "away" ? " active" : "")} type="button" onClick=${function () { manualPossession("away"); }}><span class="ec-pos-value">${possession.away}%</span><span class="ec-pos-label">Away possession</span></button>
          </div>
          <div class="ec-metric-sections">${METRIC_SECTIONS.map(function (section) {
            return html`<section key=${section.id} class="ec-metric-section">
              <div class="ec-metric-section-head"><span>${section.title}</span><small>${section.description}</small></div>
              <div class="ec-metric-grid">${section.metrics.map(function (metric) {
                var homeCount = events.filter(function (event) { return event.key === metric.key && event.team === "home"; }).length;
                var awayCount = events.filter(function (event) { return event.key === metric.key && event.team === "away"; }).length;
                var count = homeCount + awayCount;
                return html`<button key=${metric.key} class="ec-metric-btn" type="button" onClick=${function () { openMetric(metric.key); }} aria-label=${metric.label + ": " + count}>
                  <span class="ec-metric-icon" aria-hidden="true">${METRIC_GLYPHS[metric.key] || "•"}</span><span class="ec-metric-label">${metric.label}</span>
                  <span class=${"ec-metric-count" + (count ? " has-value" : "")}>${homeCount} H · ${awayCount} A</span>
                </button>`;
              })}</div>
            </section>`;
          })}</div>
          <div class="ec-event-log">
            <div class="ec-event-head"><div class="home">${homeTeam || "Home club"} events</div><div class="away">${awayTeam || "Away club"} events</div></div>
            <div class="ec-event-body">${["home", "away"].map(function (team) {
              var teamEvents = events.filter(function (event) { return event.team === team; }).slice(-50).reverse();
              return html`<div key=${team} class=${"ec-event-col " + team}>
                ${teamEvents.length ? teamEvents.map(function (event) {
                  return html`<div key=${event.id} class="ec-event" title=${event.timestampLocal || ""}>
                    <span class="ec-event-time">${event.matchClock}</span><span><strong>${event.metricLabel}</strong><span class="ec-event-detail">${[event.outcomeLabel, event.typeLabel, event.detailLabel].filter(Boolean).join(" · ") || "Recorded"}</span></span>
                  </div>`;
                }) : html`<div class="ec-event-empty">No ${team} events recorded.</div>`}
              </div>`;
            })}</div>
          </div>
        </div>
        <div class="ec-footer">
          <div class="ec-footer-group">
            <button class="ec-btn ec-btn-danger" type="button" onClick=${resetTracker}>Reset stats</button>
            <button class="ec-btn" type="button" onClick=${function () { setUndoOpen(true); }}>Undo / redo</button>
            <button class="ec-btn" type="button" onClick=${exportData}>Export JSON</button>
            <button class="ec-btn" type="button" disabled=${saving} onClick=${function () { saveDraft(false); }}>${saving ? "Saving…" : "Save draft"}</button>
          </div>
          <div class="ec-footer-group">
            <button class="ec-btn ec-btn-primary" type="button" disabled=${submitting} onClick=${function () { if (validateSubmit()) setReviewOpen(true); }}>Review & submit</button>
          </div>
        </div>
      </section>
      ${showFlow()}
      ${showUndo()}
      ${reviewOpen ? html`<div class="ec-overlay">
        <div class="ec-dialog" role="dialog" aria-modal="true">
          <div class="ec-dialog-head"><div><div class="ec-dialog-title">Review club match submission</div><div class="ec-muted">${homeTeam || "Home club"} vs ${awayTeam || "Away club"}</div></div>
            <button class="ec-btn" type="button" disabled=${submitting} onClick=${function () { setReviewOpen(false); }}>×</button>
          </div>
          <div class="ec-dialog-body">
            <div class="ec-review-grid">
              <div class="ec-review-stat"><strong>${scoreA}</strong><span>${homeTeam || "Home"}</span></div>
              <div class="ec-review-stat"><strong>${events.length}</strong><span>Club events</span></div>
              <div class="ec-review-stat"><strong>${scoreB}</strong><span>${awayTeam || "Away"}</span></div>
            </div>
            <p class="ec-muted">This submits the club event journal, derived team statistics, possession timeline, score, and assignment match details.</p>
            <div class="ec-dialog-actions">
              <button class="ec-btn" type="button" disabled=${submitting} onClick=${function () { setReviewOpen(false); }}>Back to tracking</button>
              <button class="ec-btn ec-btn-success" type="button" disabled=${submitting} onClick=${submitStats}>${submitting ? "Submitting…" : "Confirm & submit"}</button>
            </div>
          </div>
        </div>
      </div>` : null}
    `;
  }

  function ClubAssignmentsTrackerApp(props) {
    props = props || {};
    var _tab = useState(props.initialTab === "club-tracker" ? "club-tracker" : "club-assignments"), activeTab = _tab[0], setActiveTab = _tab[1];
    var _assignments = useState(Array.isArray(props.initialAssignments) ? props.initialAssignments.filter(isClubAssignment).map(normalizeClubAssignment) : []), assignments = _assignments[0], setAssignments = _assignments[1];
    var _assignmentView = useState("all"), assignmentView = _assignmentView[0], setAssignmentView = _assignmentView[1];
    var _selected = useState(null), selected = _selected[0], setSelected = _selected[1];
    var _user = useState(props.currentUser || null), user = _user[0], setUser = _user[1];
    var _loading = useState(!Array.isArray(props.initialAssignments)), loading = _loading[0], setLoading = _loading[1];
    var _busy = useState(""), busy = _busy[0], setBusy = _busy[1];
    var _error = useState(""), error = _error[0], setError = _error[1];
    var _notice = useState(null), notice = _notice[0], setNotice = _notice[1];
    var _completed = useState([]), completed = _completed[0], setCompleted = _completed[1];
    var noticeTimer = useRef(null);

    function notify(message, kind) {
      setNotice({ message: message, kind: kind || "info" });
      if (noticeTimer.current) clearTimeout(noticeTimer.current);
      noticeTimer.current = setTimeout(function () { setNotice(null); }, 4200);
    }

    async function loadAssignments() {
      setLoading(true);
      setError("");
      try {
        var response = await request(API.assignments, { method: "GET" }, props);
        var incoming = listFromResponse(response).filter(isClubAssignment).map(normalizeClubAssignment);
        incoming.forEach(function (item) {
          if (!assignmentHasPassedDay(item)) return;
          item.status = "declined";
          item.hiddenFromCards = true;
          item.autoRejectedExpired = true;
          var expiredId = assignmentId(item);
          if (!expiredId || typeof sessionStorage === "undefined") return;
          var storageKey = "enejistats_expired_assignment_rejected_" + expiredId;
          try {
            if (sessionStorage.getItem(storageKey)) return;
            sessionStorage.setItem(storageKey, "1");
            request(API.declineAssignment, {
              method: "POST",
              body: JSON.stringify({
                assignmentId: expiredId,
                assignment_id: expiredId,
                reason: "expired",
                rejection_reason: "Assignment date passed without completion"
              })
            }, props).catch(function () {
              try { sessionStorage.removeItem(storageKey); } catch (_) {}
            });
          } catch (_) {}
        });
        setAssignments(incoming);
        try {
          localStorage.setItem("eneji-club-assignments-cache", JSON.stringify(incoming));
        } catch (_) {}
      } catch (loadError) {
        var fallback = readFallbackAssignments();
        if (!fallback.length) {
          try {
            fallback = JSON.parse(localStorage.getItem("eneji-club-assignments-cache") || "[]");
          } catch (_) {}
        }
        fallback = (Array.isArray(fallback) ? fallback : []).filter(isClubAssignment).map(normalizeClubAssignment);
        if (fallback.length) {
          setAssignments(fallback);
          setError("Live assignments are unavailable. Showing saved club assignments.");
        } else {
          setError("Could not load club assignments: " + (loadError.message || "Request failed."));
        }
      } finally {
        setLoading(false);
      }
    }

    useEffect(function () {
      if (Array.isArray(props.initialAssignments)) {
        setAssignments(props.initialAssignments.filter(isClubAssignment).map(normalizeClubAssignment));
        setLoading(false);
      } else {
        loadAssignments();
      }
      if (!props.currentUser) {
        request(API.userInfo, { method: "GET" }, props).then(function (response) {
          var value = response && typeof response === "object" ? response : {};
          setUser({ id: value._id || value.id || "", dco_id: value.dco_id || value.id || "", name: value.name || value.fullName || "DCO" });
        }).catch(function () {});
      }
      var applySharedAssignments = function () {
        try {
          var shared = JSON.parse(localStorage.getItem("eneji-matchday-shared-v1") || "{}");
          if (!Array.isArray(shared.assignments)) return;
          var clubRows = shared.assignments.filter(isClubAssignment).map(normalizeClubAssignment);
          setAssignments(function (previous) {
            var byId = new Map(previous.map(function (item) { return [assignmentId(item) || JSON.stringify(item), item]; }));
            clubRows.forEach(function (item) {
              var key = assignmentId(item) || JSON.stringify(item);
              byId.set(key, Object.assign({}, byId.get(key) || {}, item));
            });
            return Array.from(byId.values());
          });
        } catch (_) {}
      };
      var onStorage = function (event) {
        if (event && event.key === "eneji-matchday-shared-v1") applySharedAssignments();
      };
      if (typeof window !== "undefined") window.addEventListener("storage", onStorage);
      var channel = null;
      try {
        if (typeof BroadcastChannel !== "undefined") {
          channel = new BroadcastChannel("eneji-matchday-sync-v1");
          channel.onmessage = applySharedAssignments;
        }
      } catch (_) {}
      return function () {
        if (noticeTimer.current) clearTimeout(noticeTimer.current);
        if (typeof window !== "undefined") window.removeEventListener("storage", onStorage);
        if (channel) channel.close();
      };
    }, []);

    useEffect(function () {
      if (props.currentUser) setUser(props.currentUser);
    }, [props.currentUser]);

    async function accept(item) {
      var id = assignmentId(item);
      if (!id) {
        notify("This assignment has no usable ID.", "error");
        return;
      }
      setBusy(id);
      try {
        var response = await request(API.acceptAssignment, {
          method: "POST",
          body: JSON.stringify({ assignmentId: id, assignment_id: id })
        }, props);
        setAssignments(function (prev) { return prev.map(function (row) {
          return assignmentId(row) === id ? Object.assign({}, row, { status: "accepted" }) : row;
        }); });
        notify(response && response.message || "Club assignment accepted.", "success");
      } catch (acceptError) {
        notify("Could not accept club assignment: " + (acceptError.message || "Request failed."), "error");
      } finally {
        setBusy("");
      }
    }

    async function decline(item) {
      var id = assignmentId(item);
      if (!id) {
        notify("This assignment has no usable ID.", "error");
        return;
      }
      if (typeof confirm === "function" && !confirm("Decline this club assignment?")) return;
      setBusy(id);
      try {
        var response = await request(API.declineAssignment, {
          method: "POST",
          body: JSON.stringify({ assignmentId: id, assignment_id: id })
        }, props);
        setAssignments(function (prev) { return prev.map(function (row) {
          return assignmentId(row) === id ? Object.assign({}, row, { status: "declined", hiddenFromCards: true }) : row;
        }); });
        notify(response && response.message || "Club assignment declined.", "success");
      } catch (declineError) {
        notify("Could not decline club assignment: " + (declineError.message || "Request failed."), "error");
      } finally {
        setBusy("");
      }
    }

    function track(item) {
      var normalized = normalizeClubAssignment(item);
      var access = checkTrackingAccess(normalized);
      if (!access.allowed) {
        notify(access.message, "warning");
        return;
      }
      setSelected(normalized);
      setActiveTab("club-tracker");
    }

    function onCompleted(result) {
      var ids = Array.isArray(result && result.assignmentIds) ? result.assignmentIds : [];
      if (ids.length) setCompleted(function (prev) { return Array.from(new Set(prev.concat(ids.map(String)))); });
      setSelected(null);
      setActiveTab("club-assignments");
      if (typeof props.onAssignmentCompleted === "function") props.onAssignmentCompleted(result);
    }

    var activeAssignments = assignments.filter(function (item) {
      if (!item || item.hiddenFromCards || assignmentHasPassedDay(item) || completed.indexOf(assignmentId(item)) >= 0) return false;
      var status = text(item.status).toLowerCase().replace(/[\s-]+/g, "_");
      return ["completed", "complete", "submitted", "declined", "cancelled", "canceled", "expired"].indexOf(status) < 0;
    });
    var visibleAssignments = activeAssignments.filter(function (item) {
      var status = text(item.status).toLowerCase();
      if (assignmentView === "pending") return status === "assigned" || status === "pending";
      if (assignmentView === "accepted") return status === "accepted";
      return true;
    });

    return html`
      <div class="eneji-club-root">
        <header class="ec-header">
          <div><h1 class="ec-brand">Club Stats Tracker</h1><p class="ec-subtitle">Club assignments, match events, possession and statistics.</p></div>
          <div class="ec-muted">${user && user.name ? "Signed in as " + user.name : "DCO session"}</div>
        </header>
        <nav class="ec-tabs" role="tablist" aria-label="Club tracker tabs">
          <button type="button" role="tab" aria-selected=${activeTab === "club-assignments"} class=${"ec-tab" + (activeTab === "club-assignments" ? " active" : "")} onClick=${function () { setActiveTab("club-assignments"); }}>Club Assignments</button>
          <button type="button" role="tab" aria-selected=${activeTab === "club-tracker"} class=${"ec-tab" + (activeTab === "club-tracker" ? " active" : "")} onClick=${function () { setActiveTab("club-tracker"); }}>Club Tracker</button>
        </nav>
        ${activeTab === "club-assignments" ? html`
          <section class="ec-panel" role="tabpanel" aria-label="Club Assignments">
            <div class="ec-toolbar">
              <div class="ec-filterbar" role="group" aria-label="Club assignment filter">
                <button class=${"ec-btn" + (assignmentView === "all" ? " ec-btn-primary" : "")} type="button" onClick=${function () { setAssignmentView("all"); }}>All</button>
                <button class=${"ec-btn" + (assignmentView === "pending" ? " ec-btn-primary" : "")} type="button" onClick=${function () { setAssignmentView("pending"); }}>Pending</button>
                <button class=${"ec-btn" + (assignmentView === "accepted" ? " ec-btn-primary" : "")} type="button" onClick=${function () { setAssignmentView("accepted"); }}>Accepted</button>
              </div>
              <div class="ec-filterbar">
                <span class="ec-muted">${visibleAssignments.length} club assignment${visibleAssignments.length === 1 ? "" : "s"}</span>
                <button class="ec-btn ec-btn-ghost" type="button" disabled=${loading} onClick=${loadAssignments}>↻ Refresh</button>
              </div>
            </div>
            ${error ? html`<div class="ec-error" role="status">${error}</div>` : null}
            ${loading ? html`<div class="ec-empty">Loading club assignments…</div>` :
              visibleAssignments.length ? html`<div class="ec-cards">${visibleAssignments.map(function (item) {
                return html`<div key=${assignmentId(item) || item.reference_id || item.club_id} style=${{ opacity: busy === assignmentId(item) ? 0.55 : 1, pointerEvents: busy === assignmentId(item) ? "none" : "auto" }}>
                  <${ClubAssignmentCard} assignment=${item} onAccept=${accept} onDecline=${decline} onTrack=${track} />
                </div>`;
              })}</div>` :
              html`<div class="ec-empty"><strong>No club assignments found</strong>Assigned club stats requests will appear here.</div>`}
          </section>
        ` : html`
          <div role="tabpanel" aria-label="Club Tracker">
            <div class="ec-toolbar" style="margin:0 0 8px">
              <button class="ec-btn" type="button" onClick=${function () { setActiveTab("club-assignments"); }}>← Club Assignments</button>
              ${selected ? html`<span class="ec-muted">Assignment: ${selected.clubName || selected.club_name || selected.club_id || "Club"}</span>` : html`<span class="ec-muted">Standalone club match tracking</span>`}
            </div>
            <${ClubTracker} key=${assignmentId(selected) || "standalone-club"} assignment=${selected || {}} currentUser=${user} api=${props.api} apiBase=${props.apiBase} fetch=${props.fetch} tokenStorageKey=${props.tokenStorageKey} onNotice=${notify} onAssignmentCompleted=${onCompleted} onSubmissionComplete=${props.onSubmissionComplete} />
          </div>
        `}
        ${notice ? html`<div class=${"ec-notice " + notice.kind} role="status">${notice.message}</div>` : null}
      </div>
    `;
  }

  function mount(target, props) {
    if (typeof document === "undefined") throw new Error("mount() requires a browser document.");
    var element = typeof target === "string" ? document.querySelector(target) : target;
    if (!element) throw new Error("EnejiClubTracker.mount could not find its target element.");
    ensureStyles();
    render(h(ClubAssignmentsTrackerApp, props || {}), element);
    return {
      element: element,
      unmount: function () { render(null, element); }
    };
  }

  return {
    version: "1.0.0",
    mount: mount,
    App: ClubAssignmentsTrackerApp,
    ClubTracker: ClubTracker,
    ClubAssignmentCard: ClubAssignmentCard,
    isClubAssignment: isClubAssignment,
    normalizeClubAssignment: normalizeClubAssignment,
    checkTrackingAccess: checkTrackingAccess,
    metrics: METRIC_SECTIONS,
    deriveStats: deriveStats,
    buildPossession: buildPossession
  };
});

  </script>
  <script>
    // Serve this page from the authenticated Stats Tracker origin so its DCO API endpoints are available.
    window.EnejiClubTracker.mount("#club-stats-root", window.ENEJISTATS_CLUB_TRACKER_OPTIONS || {});
  </script>
